{
  "name": "create-ghuri",
  "version": "0.1.0-alpha.0",
  "description": "Create a new Ghuri project: npm create ghuri@latest",
  "type": "module",
  "license": "MIT",
  "author": "Ghuri contributors",
  "homepage": "https://github.com/ghurijs/create-ghuri#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghurijs/create-ghuri.git"
  },
  "bugs": {
    "url": "https://github.com/ghurijs/create-ghuri/issues"
  },
  "keywords": [
    "ghuri",
    "django",
    "cloudflare",
    "workers",
    "hono",
    "drizzle",
    "d1",
    "r2",
    "framework"
  ],
  "bin": {
    "create-ghuri": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js"
    }
  },
  "main": "./dist/create.js",
  "types": "./dist/create.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "dependencies": {
    "@ghuri/cli": "^0.1.0-alpha.0",
    "@clack/prompts": "^1.9.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsup": "^8.5.1",
    "vitest": "^5.1.0",
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
